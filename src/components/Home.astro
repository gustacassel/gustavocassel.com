---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import CodeWindow from './CodeWindow.astro';
import { profile, socialLinks, getContent, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getContent(lang);
const { services, platforms, process, experience, stack, about, contact } = copy;
---

<BaseLayout lang={lang} title={copy.seo.title} description={copy.seo.description}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><i aria-hidden="true"></i>{copy.hero.eyebrow}</p>
      <h1 id="hero-title" set:html={copy.hero.title} />
      <p class="hero-summary">{copy.hero.summary}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#contact">{copy.hero.primaryCta} <Icon name="arrow-right" size={17} /></a>
        <a class="button button-ghost" href="#services">{copy.hero.secondaryCta}</a>
      </div>
    </div>
    <CodeWindow lang={lang} />
  </section>

  <section class="section container" id="services" aria-labelledby="services-title">
    <header class="section-head" data-reveal>
      <div>
        <p class="kicker">{services.kicker}</p>
        <h2 id="services-title" set:html={services.title} />
      </div>
      {services.intro && <p class="section-intro">{services.intro}</p>}
    </header>
    <ul class="services-grid">
      {services.items.map((item, index) => (
        <li class="card service-card" data-reveal>
          <div class="service-top">
            <span class="service-icon"><Icon name={item.icon} size={20} /></span>
            <span class="index">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container" id="platforms" aria-labelledby="platforms-title">
    <header class="section-head" data-reveal>
      <div>
        <p class="kicker">{platforms.kicker}</p>
        <h2 id="platforms-title" set:html={platforms.title} />
      </div>
      {platforms.intro && <p class="section-intro">{platforms.intro}</p>}
    </header>
    <ul class="platforms-grid">
      {platforms.items.map((item) => (
        <li class="card platform-card" data-reveal>
          <span class="platform-vendor">{item.vendor}</span>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section container" id="process" aria-labelledby="process-title">
    <header class="section-head" data-reveal>
      <div>
        <p class="kicker">{process.kicker}</p>
        <h2 id="process-title" set:html={process.title} />
      </div>
      {process.intro && <p class="section-intro">{process.intro}</p>}
    </header>
    <ol class="process-steps">
      {process.steps.map((step, index) => (
        <li data-reveal>
          <span class="step-number">{index + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container" id="experience" aria-labelledby="experience-title">
    <div class="experience-grid">
      <header class="experience-head" data-reveal>
        <p class="kicker">{experience.kicker}</p>
        <h2 id="experience-title" set:html={experience.title} />
        {experience.intro && <p class="section-intro">{experience.intro}</p>}
        <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{experience.link} <Icon name="arrow-up-right" size={15} /></a>
        <div class="certs">
          <p class="certs-title">{experience.certsTitle}</p>
          <ul>
            {experience.certs.map((cert) => <li><Icon name="check" size={14} /> {cert}</li>)}
          </ul>
        </div>
      </header>
      <ol class="timeline">
        {experience.items.map((item) => (
          <li class="timeline-item" data-reveal>
            <div class="timeline-head">
              <h3>{item.company}</h3>
              {item.location && <span>{item.location}</span>}
            </div>
            <ul class="timeline-roles">
              {item.roles.map((role) => (
                <li><strong>{role.title}</strong><span>{role.dates}</span></li>
              ))}
            </ul>
            <p>{item.note}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section container" id="stack" aria-labelledby="stack-title">
    <header class="section-head" data-reveal>
      <div>
        <p class="kicker">{stack.kicker}</p>
        <h2 id="stack-title" set:html={stack.title} />
      </div>
      {stack.intro && <p class="section-intro">{stack.intro}</p>}
    </header>
    <div class="stack-grid">
      {stack.groups.map((group) => (
        <div class="stack-group" data-reveal>
          <p class="stack-label">{group.label}</p>
          <ul class="chips">{group.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section container" id="about" aria-labelledby="about-title">
    <div class="about-grid">
      <header data-reveal>
        <p class="kicker">{about.kicker}</p>
        <h2 id="about-title" set:html={about.title} />
        <ul class="about-facts">{about.facts.map((fact) => <li><span aria-hidden="true">{fact.emoji}</span>{fact.label}</li>)}</ul>
      </header>
      <div class="about-text" data-reveal>
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="container contact-wrap" id="contact" aria-labelledby="contact-title">
    <div class="contact" data-reveal>
      <p class="kicker">{contact.kicker}</p>
      <h2 id="contact-title" set:html={contact.title} />
      <p class="contact-body">{contact.body}</p>
      <div class="contact-actions">
        <a class="button button-contrast" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{contact.cta} <Icon name="arrow-up-right" size={17} /></a>
        <ul class="contact-socials">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
                <Icon name={link.icon} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
