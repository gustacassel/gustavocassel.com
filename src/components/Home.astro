---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import IntegrationDemo from './IntegrationDemo.astro';
import { profile, socialLinks, getContent, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getContent(lang);
---

<BaseLayout lang={lang} title={copy.seo.title} description={copy.seo.description}>
  <section class="hero shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow-row">
        <span class="eyebrow"><i></i> {copy.hero.eyebrow}</span>
        <span class="hero-location">{copy.hero.location}</span>
      </div>

      <h1 id="hero-title">
        {copy.hero.lead}<br />
        <span>{copy.hero.middle}</span>
        <em>{copy.hero.accent}</em>
      </h1>

      <div class="hero-bottom">
        <p>{copy.hero.summary}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#about">{copy.hero.primaryCta} <Icon name="arrow-right" size={17} /></a>
          <a class="button button-ghost" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{copy.hero.secondaryCta} <Icon name="linkedin" size={17} /></a>
        </div>
      </div>
    </div>

    <div class="hero-demo-wrap">
      <div class="hero-stamp" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <defs><path id="stamp-path" d="M50,50 m-35,0 a35,35 0 1,1 70,0 a35,35 0 1,1 -70,0" /></defs>
          <text><textPath href="#stamp-path">{copy.hero.stamp}</textPath></text>
        </svg>
        <span>{profile.initials}</span>
      </div>
      <IntegrationDemo lang={lang} />
    </div>
  </section>

  <section class="proof-bar" aria-label={copy.techStripAria}>
    <div class="proof-track">
      {[false, true].map((isClone) => (
        <div class="proof-group" aria-hidden={isClone ? 'true' : undefined}>
          {copy.techStrip.map((item) => (
            <div class="proof-item">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
              <i aria-hidden="true"></i>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="section expertise-section shell" id="expertise" aria-labelledby="expertise-title">
    <div class="section-intro compact" data-reveal>
      <div>
        <span class="section-kicker">{copy.expertise.kicker}</span>
        <h2 id="expertise-title" set:html={copy.expertise.title} />
      </div>
      <p>{copy.expertise.intro}</p>
    </div>

    <div class="expertise-grid">
      {copy.expertise.items.map((item) => (
        <article class="expertise-card" data-reveal>
          <span class="expertise-number">{item.number}</span>
          <div class="expertise-icon" aria-hidden="true"><i></i><i></i><i></i></div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <div class="tool-cloud">{item.tools.map((tool) => <span>{tool}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="section journey-section" id="about" aria-labelledby="journey-title">
    <div class="shell journey-grid">
      <div class="journey-heading" data-reveal>
        <span class="section-kicker">{copy.journey.kicker}</span>
        <h2 id="journey-title" set:html={copy.journey.title} />
        <p>{copy.journey.intro}</p>
        <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{copy.journey.link} <Icon name="arrow-up-right" size={16} /></a>
      </div>

      <div class="timeline">
        {copy.journey.items.map((item, index) => (
          <article class="timeline-item" data-reveal>
            <div class="timeline-marker" aria-hidden="true">
              <strong>{item.marker}</strong>
              <span>0{index + 1}</span>
            </div>
            <div class="timeline-copy">
              <div class="timeline-company"><h3>{item.company}</h3>{item.location && <span>{item.location}</span>}</div>
              {item.roles.map((role) => (
                <div class="timeline-role"><strong>{role.title}</strong><span>{role.dates}</span></div>
              ))}
              <p>{item.note}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section builder-section shell" aria-labelledby="builder-title">
    <div class="builder-grid">
      <div class="builder-story" data-reveal>
        <span class="section-kicker">{copy.builder.kicker}</span>
        <h2 id="builder-title" set:html={copy.builder.title} />
        <p class="builder-lead">{copy.builder.lead}</p>
        <p>{copy.builder.body}</p>
      </div>

      <div class="builder-cards">
        <a class="builder-card founder-card" href={copy.builder.spotlight.href} target="_blank" rel="noopener noreferrer" data-reveal>
          <span class="builder-card-label">{copy.builder.spotlight.label}</span>
          <div class="builder-card-art" aria-hidden="true"><i></i><i></i><b></b></div>
          <strong>{copy.builder.spotlight.title}</strong>
          <small>{copy.builder.spotlight.cta} <Icon name="arrow-up-right" size={15} /></small>
        </a>
        <div class="builder-card education-card" data-reveal>
          <span class="builder-card-label">{copy.builder.certs.label}</span>
          <strong>{copy.builder.certs.title}</strong>
          <p>{copy.builder.certs.subtitle}</p>
          <div class="cert-list">
            {copy.builder.certs.items.map((cert) => <span><Icon name="check" size={14} /> {cert}</span>)}
          </div>
        </div>
        <figure class="portrait-card" data-reveal>
          <div class="portrait-copy">
            <span>{copy.builder.portrait.label}</span>
            <strong set:html={copy.builder.portrait.title} />
            <small>{copy.builder.portrait.caption}</small>
          </div>
          <i class="portrait-mark" aria-hidden="true">{profile.initials}</i>
        </figure>
      </div>
    </div>
  </section>

  <section class="contact-section shell" id="contact" aria-labelledby="contact-title" data-reveal>
    <div class="contact-orb" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="contact-copy">
      <span class="section-kicker">{copy.contact.kicker}</span>
      <h2 id="contact-title" set:html={copy.contact.title} />
      <p>{copy.contact.body}</p>
      <div class="contact-actions">
        <a class="button button-light" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{copy.contact.cta} <Icon name="arrow-up-right" size={17} /></a>
      </div>
    </div>
    <div class="contact-socials">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
          <Icon name={link.icon} size={19} />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
