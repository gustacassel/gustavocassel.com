---
import Icon from './Icon.astro';
import { profile, socialLinks, getContent, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = getContent(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <p class="footer-name">{profile.name}</p>
      <p class="footer-tagline">{copy.footer.tagline}</p>
    </div>
    <ul class="footer-links">
      {socialLinks.map((link) => (
        <li>
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <Icon name={link.icon} size={16} /> {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {profile.name}</span>
    <a href="#top">{copy.footer.backToTop} ↑</a>
  </div>
</footer>
