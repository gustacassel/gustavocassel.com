---
import Icon from './Icon.astro';
import { profile, getContent, languages, routes, type Lang, type Alternates } from '../data/site';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const copy = getContent(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';

const isHome = Astro.url.pathname === routes.home(lang) || Astro.url.pathname === `${routes.home(lang)}/`;
const anchor = (id: string) => (isHome ? `#${id}` : routes.section(lang, id));
const nav = [
  { label: copy.nav.services, href: anchor('services') },
  { label: copy.nav.experience, href: anchor('experience') },
  { label: copy.nav.about, href: anchor('about') },
  { label: copy.nav.contact, href: anchor('contact') },
];
---

<header class="site-header" data-header>
  <div class="header-inner container">
    <a class="brand" href={routes.home(lang)}>
      <span class="brand-mark" aria-hidden="true">G</span>
      <span>{profile.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label={copy.ui.primaryNav} data-nav>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="header-actions">
      <a class="pill-button" href={alternates[otherLang]} hreflang={languages[otherLang].htmlLang} lang={languages[otherLang].htmlLang} aria-label={copy.ui.switchLang} title={copy.ui.switchLang}>
        {languages[otherLang].label}
      </a>
      <button
        class="pill-button"
        type="button"
        aria-label={copy.ui.themeToDark}
        aria-pressed="false"
        title={copy.ui.themeToDark}
        data-theme-toggle
        data-label-dark={copy.ui.themeToDark}
        data-label-light={copy.ui.themeToLight}
      >
        <span class="theme-icon-sun"><Icon name="sun" size={16} /></span>
        <span class="theme-icon-moon"><Icon name="moon" size={16} /></span>
      </button>
      <a class="button button-primary button-small header-cta" href={anchor('contact')}>{copy.ui.headerCta}</a>
      <button
        class="pill-button nav-toggle"
        type="button"
        aria-label={copy.ui.openNav}
        aria-expanded="false"
        aria-controls="site-nav"
        data-nav-toggle
        data-label-open={copy.ui.openNav}
        data-label-close={copy.ui.closeNav}
      >
        <span class="nav-open"><Icon name="menu" size={18} /></span>
        <span class="nav-close"><Icon name="close" size={18} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const setupHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    if (!header || !toggle || !nav || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';

    const setOpen = (open: boolean) => {
      header.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
    };

    toggle.addEventListener('click', () => setOpen(!header.classList.contains('menu-open')));
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !header.classList.contains('menu-open')) return;
      setOpen(false);
      toggle.focus();
    });
  };

  const setupThemeToggle = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]:not([data-ready])').forEach((toggle) => {
      toggle.dataset.ready = 'true';

      const updateLabel = () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const label = (isDark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
        toggle.setAttribute('aria-pressed', String(isDark));
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.setAttribute('content', isDark ? '#141218' : '#f5f0e8');
        });
      };

      toggle.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem('gc-theme', nextTheme); } catch {}
        updateLabel();
      });

      updateLabel();
    });
  };

  setupHeader();
  setupThemeToggle();
</script>
