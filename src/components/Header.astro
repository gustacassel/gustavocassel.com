---
import Icon from './Icon.astro';
import { profile, getContent, languages, routes, type Lang, type Alternates } from '../data/site';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const copy = getContent(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';

const isHome = Astro.url.pathname === routes.home(lang) || Astro.url.pathname === `${routes.home(lang)}/`;
const anchor = (id: string) => (isHome ? `#${id}` : routes.section(lang, id));
const nav = [
  { label: copy.nav.expertise, href: anchor('expertise') },
  { label: copy.nav.about, href: anchor('about') },
  { label: copy.nav.contact, href: anchor('contact') },
];
---

<header class="site-header" data-header>
  <div class="header-inner shell">
    <a class="brand" href={routes.home(lang)}>
        <span class="brand-mark" aria-hidden="true">{profile.initials.slice(0, 1)}</span>
        <span class="brand-copy">
        <strong>{profile.name}</strong>
        <small>{copy.role}</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label={copy.ui.primaryNav}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="lang-toggle" href={alternates[otherLang]} hreflang={languages[otherLang].htmlLang} lang={languages[otherLang].htmlLang} aria-label={copy.ui.switchLang} title={copy.ui.switchLang}>
        {languages[otherLang].label}
      </a>
      <button
        class="theme-toggle"
        type="button"
        aria-label={copy.ui.themeToDark}
        aria-pressed="false"
        title={copy.ui.themeToDark}
        data-theme-toggle
        data-label-dark={copy.ui.themeToDark}
        data-label-light={copy.ui.themeToLight}
      >
        <span class="theme-icon theme-icon-sun"><Icon name="sun" size={17} /></span>
        <span class="theme-icon theme-icon-moon"><Icon name="moon" size={17} /></span>
      </button>
      <a class="header-cta" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        {copy.ui.headerCta}
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-label={copy.ui.openNav}
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
      data-label-open={copy.ui.openNav}
      data-label-close={copy.ui.closeNav}
    >
      <span class="nav-open"><Icon name="menu" /></span>
      <span class="nav-close"><Icon name="close" /></span>
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label={copy.ui.mobileNav} data-mobile-nav inert>
    <div class="shell">
      {nav.map((item, index) => <a href={item.href}><span>0{index + 1}</span>{item.label}</a>)}
      <a class="mobile-contact" href={profile.linkedin} target="_blank" rel="noopener noreferrer">{copy.ui.mobileContact} <Icon name="arrow-up-right" /></a>
    </div>
  </nav>
</header>

<script>
  const setupHeader = () => {
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
    if (!header || !toggle || !mobileNav || toggle.dataset.ready) return;
    toggle.dataset.ready = 'true';
    const openLabel = toggle.dataset.labelOpen ?? '';
    const closeLabel = toggle.dataset.labelClose ?? '';

    const close = () => {
      header.classList.remove('menu-open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', openLabel);
      mobileNav.inert = true;
      document.body.classList.remove('nav-locked');
    };

    toggle.addEventListener('click', () => {
      const willOpen = !header.classList.contains('menu-open');
      if (!willOpen) {
        close();
        return;
      }
      header.classList.add('menu-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', closeLabel);
      mobileNav.inert = false;
      document.body.classList.add('nav-locked');
      requestAnimationFrame(() => mobileNav.querySelector<HTMLAnchorElement>('a')?.focus());
    });

    mobileNav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !header.classList.contains('menu-open')) return;
      close();
      toggle.focus();
    });
    window.addEventListener('resize', () => { if (window.innerWidth > 820) close(); }, { passive: true });
  };
  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>

<script>
  const setupThemeToggle = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]:not([data-theme-ready])').forEach((toggle) => {
      toggle.dataset.themeReady = 'true';

      const updateLabel = () => {
        const isDark = document.documentElement.dataset.theme === 'dark';
        const label = (isDark ? toggle.dataset.labelLight : toggle.dataset.labelDark) ?? '';
        toggle.setAttribute('aria-label', label);
        toggle.setAttribute('title', label);
        toggle.setAttribute('aria-pressed', String(isDark));
        document.querySelectorAll('meta[name="theme-color"]').forEach((meta) => {
          meta.setAttribute('content', isDark ? '#111016' : '#f5f0e8');
        });
      };

      toggle.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem('gc-theme', nextTheme); } catch {}
        updateLabel();
      });

      updateLabel();
    });
  };

  setupThemeToggle();
  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
